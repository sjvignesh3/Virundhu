{
  "name": "@virundhu/client",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-agnostic typed data layer that fronts Supabase (PostgREST + Auth + Realtime + Edge Functions). Consumed by the Vite SPA and any future clients.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:no-star-select": "node scripts/no-star-select.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "~2.45.4",
    "@virundhu/shared": "*",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
