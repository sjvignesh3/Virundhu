# =============================================================
# CartSas — Monorepo .gitignore
# =============================================================

# ──────────────────────────────────────────────────────────────
# Dependencies  (never commit node_modules)
# ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache/
.yarn/unplugged/

# ──────────────────────────────────────────────────────────────
# Build outputs
# ──────────────────────────────────────────────────────────────
# NestJS / TypeScript compiled output
apps/api/dist/
packages/shared/dist/

# Next.js build output
apps/web/.next/
apps/web/out/

# Keep migration SQL files (they ARE source-controlled)
!apps/api/prisma/migrations/**/migration.sql
!apps/api/prisma/migrations/migration_lock.toml

# ──────────────────────────────────────────────────────────────
# TypeScript incremental build cache
# ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ──────────────────────────────────────────────────────────────
# Test / coverage artefacts
# ──────────────────────────────────────────────────────────────
**/coverage/
.nyc_output/
lcov.info
*.lcov
junit.xml
test-results/

# ──────────────────────────────────────────────────────────────
# Environment / secrets  (NEVER commit real secrets)
# ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
# Keep example files so developers can bootstrap
!.env.example
!**/.env.example

# ──────────────────────────────────────────────────────────────
# SQLite databases  (local dev db — not for version control)
# ──────────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ──────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────────────────────────────────────────────────────────
# OS & editor artefacts
# ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws

# VS Code (keep recommended extensions / settings if desired)
# .vscode/           ← commented out so team settings can be shared
# Personal per-user overrides — never shared
.vscode/settings.json
.vscode/*.code-workspace

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#
.\#*

# ──────────────────────────────────────────────────────────────
# Package-manager lock files  (keep one; ignore the rest)
# ──────────────────────────────────────────────────────────────
# This project uses npm → keep package-lock.json, ignore others
yarn.lock
pnpm-lock.yaml
bun.lockb

# ──────────────────────────────────────────────────────────────
# Vercel / deployment
# ──────────────────────────────────────────────────────────────
.vercel/
.netlify/

# ──────────────────────────────────────────────────────────────
# Miscellaneous
# ──────────────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
*.pfx

# Storybook
storybook-static/

# Turbo
.turbo/

# Playwright / Cypress
playwright-report/
cypress/videos/
cypress/screenshots/

# SWC (Next.js native compiler cache)
.swc/
apps/web/.swc/
