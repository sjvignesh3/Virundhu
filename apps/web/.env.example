# Copy this to .env.local for local dev; on Vercel set these under
# Project Settings → Environment Variables (see Docs/Deployment.md).

# Base URL of the NestJS API, must end with /api
# Local dev:  http://localhost:4000/api
# Production: https://virundhu-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Which repository layer the web app uses:
#   "api"    → real backend (production, staging, real local dev)
#   "local"  → offline Phase-1 demo backed by localStorage
NEXT_PUBLIC_REPO_BACKEND=api
