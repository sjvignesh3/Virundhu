# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL is required (SQLite is not persistent on managed hosts).
# Local dev:  DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virundhu?schema=public"
# Production: paste the Internal Connection String from your DB provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virundhu?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT="4000"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN="http://localhost:3000"

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS="12"
