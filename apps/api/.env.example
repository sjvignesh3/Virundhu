# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL is required (SQLite is not persistent on managed hosts).
#
# Local dev:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virundhu?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/virundhu?schema=public"
#
# Supabase (production / Render):
#   Both URLs use port 5432.  Do NOT use port 6543 (transaction pooler) —
#   it does not support prepared statements required by prisma migrate deploy.
#
#   DATABASE_URL  → Session Pooler URL  (port 5432) — for runtime queries
#   DIRECT_URL    → Direct Connection   (port 5432) — for prisma migrate deploy
#
#   Get both from: Supabase Dashboard → Project → Connect → Connection String
#   Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virundhu?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/virundhu?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT="4000"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN="http://localhost:3000"

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS="12"
