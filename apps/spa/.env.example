# Public — inlined into bundle
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_SENTRY_DSN=
VITE_APP_ENV=development

# Stage 4 — public menu edge-cached proxy.
# Leave unset (defaults to "/api/menu") for prod + Vercel dev.
# Set to "" (empty) to bypass the proxy and read Supabase directly — required
# for local `vite dev` when you are not running the Vercel dev server, and
# for `vitest`/`playwright` runs against Supabase.
# VITE_PUBLIC_MENU_BASE_URL=
