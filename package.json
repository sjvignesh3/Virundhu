{
  "name": "cartsas",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@cartsas/web",
    "dev:api": "npm run start:dev --workspace=@cartsas/api",
    "dev": "npm-run-all -p dev:api dev:web",
    "build": "npm-run-all -s build:shared build:api build:web",
    "build:shared": "npm run build --workspace=@cartsas/shared",
    "build:api": "npm run build --workspace=@cartsas/api",
    "build:web": "npm run build --workspace=@cartsas/web",
    "test": "npm-run-all -s test:shared test:api test:web",
    "test:shared": "npm run test --workspace=@cartsas/shared --if-present",
    "test:api": "npm run test --workspace=@cartsas/api",
    "test:web": "npm run test --workspace=@cartsas/web",
    "db:migrate": "npm run prisma:migrate --workspace=@cartsas/api",
    "db:seed": "npm run prisma:seed --workspace=@cartsas/api",
    "db:reset": "npm run prisma:reset --workspace=@cartsas/api",
    "db:studio": "npm run prisma:studio --workspace=@cartsas/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
